{
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/home-v2",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/home-v2/index",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/home-v2/index.html",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/alexis-soubran-TIF-CMO",
      "destination": "/alexis-soubran-tif-cmo/index.html"
    },
    {
      "source": "/alexis-soubran-tif-cmo",
      "destination": "/alexis-soubran-tif-cmo/index.html"
    }
  ],
  "headers": [
    {
      "source": "/health",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/health/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/markdown/:path*",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Link",
          "value": "</markdown/index.md>; rel=\"alternate\"; type=\"text/markdown\""
        }
      ]
    },
    {
      "source": "/program",
      "headers": [
        {
          "key": "Link",
          "value": "</markdown/program.md>; rel=\"alternate\"; type=\"text/markdown\""
        }
      ]
    },
    {
      "source": "/speakers",
      "headers": [
        {
          "key": "Link",
          "value": "</markdown/speakers.md>; rel=\"alternate\"; type=\"text/markdown\""
        }
      ]
    },
    {
      "source": "/whale-tank",
      "headers": [
        {
          "key": "Link",
          "value": "</markdown/whale-tank.md>; rel=\"alternate\"; type=\"text/markdown\""
        }
      ]
    },
    {
      "source": "/sponsorship",
      "headers": [
        {
          "key": "Link",
          "value": "</markdown/sponsorship.md>; rel=\"alternate\"; type=\"text/markdown\""
        }
      ]
    },
    {
      "source": "/press",
      "headers": [
        {
          "key": "Link",
          "value": "</markdown/press.md>; rel=\"alternate\"; type=\"text/markdown\""
        }
      ]
    },
    {
      "source": "/festival-2026",
      "headers": [
        {
          "key": "Link",
          "value": "</markdown/festival-2026.md>; rel=\"alternate\"; type=\"text/markdown\""
        }
      ]
    },
    {
      "source": "/alexis-soubran-tif-cmo",
      "headers": [
        {
          "key": "Link",
          "value": "</markdown/alexis-soubran-tif-cmo.md>; rel=\"alternate\"; type=\"text/markdown\""
        }
      ]
    },
    {
      "source": "/blog",
      "headers": [
        {
          "key": "Link",
          "value": "</markdown/blog.md>; rel=\"alternate\"; type=\"text/markdown\""
        }
      ]
    },
    {
      "source": "/blog/tif-whale-tank-sin-filtros-mvs",
      "headers": [
        {
          "key": "Link",
          "value": "</markdown/blog-tif-whale-tank-sin-filtros-mvs.md>; rel=\"alternate\"; type=\"text/markdown\""
        }
      ]
    }
  ]
}
